#!/usr/bin/env bash
#
# gaf — Game Audio Forge CLI
#
# Local audio workshop: music (acestep.cpp) + sound effects (audiogen.cpp).
# C++-First, keine eigenen Dienste. Uses the generators' existing CLI/HTTP interfaces.
#
# Befehle:
#   gaf music "prompt"   generate instrumental music (ACE-Step 1.5, SFT DiT)
#   gaf sfx "prompt"     Soundeffekt generieren (Dasheng AudioGen)
#   gaf ui               start the acestep.cpp web interface
#   gaf status           show GPU, binaries, models, FFmpeg
#   gaf help             this help
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Pfade & Konfiguration
# ---------------------------------------------------------------------------
GAF_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="$GAF_HOME/config/gaf.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "gaf: configuration not found: $CONFIG_FILE" >&2
  exit 1
fi

# jq helper: read a config value (nested paths via "a.b.c"), expand ~.
cfg() {
  local key="$1" def="${2:-}"
  local v
  v="$(jq -r --arg k "$key" 'getpath($k | split(".")) // empty' "$CONFIG_FILE" 2>/dev/null || true)"
  [[ -z "$v" ]] && v="$def"
  # expand ~
  v="${v/#\~/$HOME}"
  printf '%s' "$v"
}

TOOLS_ROOT="$(cfg tools_root "$HOME/dev/github/tools")"
OUTPUT_ROOT="$(cfg output_root "$GAF_HOME/output")"

MUSIC_REPO="$TOOLS_ROOT/acestep.cpp"
SFX_REPO="$TOOLS_ROOT/audiogen.cpp"

MUSIC_BIN_LM="$MUSIC_REPO/build/ace-lm"
MUSIC_BIN_SYNTH="$MUSIC_REPO/build/ace-synth"
MUSIC_BIN_SERVER="$MUSIC_REPO/build/ace-server"
MUSIC_MODELS="$MUSIC_REPO/models"

SFX_BIN="$SFX_REPO/build-cuda/dasheng-audiogen"
SFX_MODELS="$SFX_REPO/models"

# ---------------------------------------------------------------------------
# Hilfsfunktionen
# ---------------------------------------------------------------------------
GAF_TMPS=()
cleanup() { local t; for t in "${GAF_TMPS[@]:-}"; do [[ -n "$t" && -d "$t" ]] && rm -rf "$t"; done; return 0; }
trap cleanup EXIT

log()  { printf '\033[1;34m[gaf]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[gaf:warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[gaf:err]\033[0m %s\n' "$*" >&2; exit 1; }

# slug from prompt: lowercase, [a-z0-9-] only, max ~40 chars
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-40 \
    | sed -E 's/-+$//'
}

# collision-safe target name: appends -2, -3, ... as needed
unique_path() {
  local dir="$1" base="$2" ext="$3"
  local candidate="$dir/${base}.${ext}" n=2
  while [[ -e "$candidate" ]]; do
    candidate="$dir/${base}-${n}.${ext}"
    n=$((n+1))
  done
  printf '%s' "$candidate"
}

# write a metadata sidecar next to the audio file
# usage: write_meta <audio.wav> <jq-args…> — the rest goes to jq -n.
write_meta() {
  local audio="$1"; shift
  local meta="${audio%.*}.meta.json"
  jq -n "$@" > "$meta" 2>/dev/null || true
}

# Optional FFmpeg step: transcode/resample only on a real change
# against the source rate (music 48k, SFX 16k). Source rate = $2, channels = $3.
# Returns the final file path (may carry a new extension).
finalize_audio() {
  local file="$1" src_rate="$2" ch="$3"
  local ff_on ff_fmt ff_rate
  ff_on="$(cfg ffmpeg.enabled true)"; ff_fmt="$(cfg ffmpeg.target_format wav)"; ff_rate="$(cfg ffmpeg.target_rate 48000)"
  if [[ "$ff_on" != "true" ]] || ! command -v ffmpeg >/dev/null 2>&1; then
    printf '%s' "$file"; return
  fi
  local src_ext="${file##*.}"
  if [[ "$ff_fmt" == "$src_ext" && "$ff_rate" == "$src_rate" ]]; then
    printf '%s' "$file"; return   # no change needed
  fi
  local out="${file%.*}.${ff_fmt}"
  local tmp="${out%.*}.$$.${ff_fmt}"
  if ffmpeg -y -loglevel error -i "$file" -ar "$ff_rate" -ac "$ch" "$tmp" 2>/dev/null \
     && mv -f "$tmp" "$out"; then
    [[ "$out" != "$file" ]] && rm -f "$file"
    printf '%s' "$out"
  else
    rm -f "$tmp"; printf '%s' "$file"
  fi
}

# GPU busy check (no parallel GPU generation).
# "busy" = another GAF generator process runs (ace-lm, ace-synth,
# dasheng-audiogen). Deliberately NOT nvidia-smi compute apps: the Wayland
# compositor (kwin_wayland) and idle services (e.g. local-image-ai sd-server)
# keep the GPU "busy" forever and would block the wait loop forever.
gpu_busy() {
  pgrep -f 'ace-lm|ace-synth|dasheng-audiogen' >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# gaf music "prompt"
# ---------------------------------------------------------------------------
cmd_music() {
  # options: --bpm N --duration N --seed N --steps N
  #           --cover SRC [--cover-strength F] [--noise-strength F]
  #           --repaint SRC --from S --to S
  #           --ref AUDIO
  local opt_bpm="" opt_dur="" opt_seed="" opt_steps="" opt_cover="" opt_ref=""
  local opt_cs="" opt_ns="" opt_from="" opt_to="" opt_mode=""
  # options are scanned between/after arguments: gaf music "prompt" --bpm 160
  local -a _pos=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bpm)       opt_bpm="$2"; shift 2 ;;
      --duration)  opt_dur="$2"; shift 2 ;;
      --seed)      opt_seed="$2"; shift 2 ;;
      --steps)     opt_steps="$2"; shift 2 ;;
      --cover)     opt_cover="$2"; shift 2 ;;
      --repaint)   opt_cover="$2"; opt_mode=repaint; shift 2 ;;
      --from)      opt_from="$2"; shift 2 ;;
      --to)        opt_to="$2"; shift 2 ;;
      --cover-strength) opt_cs="$2"; shift 2 ;;
      --noise-strength) opt_ns="$2"; shift 2 ;;
      --ref)       opt_ref="$2"; shift 2 ;;
      *) _pos+=("$1"); shift ;;
    esac
  done
  local prompt="${_pos[0]:-}"
  [[ -z "$prompt" && -z "$opt_cover" ]] && die "gaf music: prompt missing. Example: gaf music \"upbeat metal racing track\""
  [[ -n "$opt_cover" && ! -f "$opt_cover" ]] && die "gaf music: source audio missing: $opt_cover"
  [[ -n "$opt_ref" && ! -f "$opt_ref" ]] && die "gaf music: reference audio missing: $opt_ref"
  # ace-synth runs in a work dir — paths must be absolute
  [[ -n "$opt_cover" ]] && opt_cover="$(cd "$(dirname "$opt_cover")" && pwd)/$(basename "$opt_cover")"
  [[ -n "$opt_ref" ]]   && opt_ref="$(cd "$(dirname "$opt_ref")" && pwd)/$(basename "$opt_ref")"

  [[ -x "$MUSIC_BIN_LM" ]]    || die "ace-lm not found: $MUSIC_BIN_LM (build missing?)"
  [[ -x "$MUSIC_BIN_SYNTH" ]] || die "ace-synth not found: $MUSIC_BIN_SYNTH (build missing?)"
  [[ -d "$MUSIC_MODELS" ]]    || die "models not found: $MUSIC_MODELS (run ./models.sh?)"

  if gpu_busy; then
    warn "GPU busy — waiting until free (no parallel generation)…"
    while gpu_busy; do sleep 5; done
    log "GPU free."
  fi

  local lm_model synth_model steps shift outfmt device duration vae_chunk
  local bpm keyscale timesignature vocal_language lm_temperature lm_cfg_scale
  local lm_top_p lm_top_k use_cot_caption solver peak_clip
  lm_model="$(cfg music.lm_model "acestep-5Hz-lm-0.6B-Q8_0.gguf")"
  synth_model="$(cfg music.synth_model "acestep-v15-turbo-Q8_0.gguf")"
  steps="$(cfg music.inference_steps 8)"
  shift="$(cfg music.shift 3.0)"
  outfmt="$(cfg music.output_format wav16)"
  device="$(cfg music.device CUDA0)"
  duration="$(cfg music.duration 32)"
  vae_chunk="$(cfg music.vae_chunk 512)"
  # extended parameters (defaults = "LLM/model decides"):
  bpm="$(cfg music.bpm 0)"
  keyscale="$(cfg music.keyscale "")"
  timesignature="$(cfg music.timesignature "")"
  vocal_language="$(cfg music.vocal_language "")"
  lm_temperature="$(cfg music.lm_temperature 0.85)"
  lm_cfg_scale="$(cfg music.lm_cfg_scale 2.0)"
  lm_top_p="$(cfg music.lm_top_p 0.9)"
  lm_top_k="$(cfg music.lm_top_k 0)"
  use_cot_caption="$(cfg music.use_cot_caption true)"
  solver="$(cfg music.solver euler)"
  peak_clip="$(cfg music.peak_clip 10)"
  # CLI overrides beat config
  [[ -n "$opt_bpm" ]]    && bpm="$opt_bpm"
  [[ -n "$opt_dur" ]]    && duration="$opt_dur"
  [[ -n "$opt_steps" ]]  && steps="$opt_steps"
  # task modes: text2music (default) | cover | repaint  (Turbo model ok)
  local task_type="${opt_mode:-text2music}"
  [[ -n "$opt_cover" && "$task_type" == "text2music" ]] && task_type="cover"
  local cs="${opt_cs:-1.0}" ns="${opt_ns:-0.0}" from="${opt_from:-0}" to="${opt_to:--1}"

  local seed
  if [[ -n "$opt_seed" ]]; then seed="$opt_seed"; else seed="$(date +%s%N | cut -c1-10)"; fi

  local ts slug outdir
  ts="$(date +%Y%m%d-%H%M%S)"
  slug="$(slugify "$prompt")"
  outdir="$OUTPUT_ROOT/music"
  mkdir -p "$outdir"

  # temp work dir for the two-stage pipeline
  # cleanup: EXIT trap (RETURN traps leak across function boundaries)
  local work
  work="$(mktemp -d)"
  GAF_TMPS+=("$work")

  local req="$work/request.json"
  jq -n \
    --arg caption "$prompt" \
    --arg lyrics "[Instrumental]" \
    --argjson seed "$seed" \
    --argjson steps "$steps" \
    --argjson shift "$shift" \
    --argjson duration "$duration" \
    --argjson bpm "$bpm" \
    --arg keyscale "$keyscale" \
    --arg timesignature "$timesignature" \
    --arg vocal_language "$vocal_language" \
    --argjson lm_temperature "$lm_temperature" \
    --argjson lm_cfg_scale "$lm_cfg_scale" \
    --argjson lm_top_p "$lm_top_p" \
    --argjson lm_top_k "$lm_top_k" \
    --argjson use_cot_caption "$use_cot_caption" \
    --arg solver "$solver" \
    --argjson peak_clip "$peak_clip" \
    --argjson cs "$cs" \
    --argjson ns "$ns" \
    --argjson from "$from" \
    --argjson to "$to" \
    --arg task "$task_type" \
    --arg outfmt "$outfmt" \
    --arg lm "$lm_model" \
    --arg synth "$synth_model" \
    '{
       caption: $caption,
       lyrics: $lyrics,
       seed: $seed,
       task_type: $task,
       inference_steps: $steps,
       shift: $shift,
       duration: $duration,
       bpm: $bpm,
       keyscale: $keyscale,
       timesignature: $timesignature,
       vocal_language: $vocal_language,
       lm_temperature: $lm_temperature,
       lm_cfg_scale: $lm_cfg_scale,
       lm_top_p: $lm_top_p,
       lm_top_k: $lm_top_k,
       use_cot_caption: $use_cot_caption,
       solver: $solver,
       peak_clip: $peak_clip,
       audio_cover_strength: $cs,
       cover_noise_strength: $ns,
       repainting_start: $from,
       repainting_end: $to,
       output_format: $outfmt,
       lm_model: $lm,
       synth_model: $synth
     }' > "$req"

  log "music (${task_type}): \"${prompt:-<cover/repaint>}\""
  log "  LM=$lm_model  DiT=$synth_model  steps=$steps  seed=$seed"

  # stages: text2music = ace-lm → ace-synth; cover/repaint = ace-synth only
  local synth_req="$work/request.json"
  local -a synth_args=( --models "$MUSIC_MODELS" --device "$device" --vae-chunk "$vae_chunk" )
  [[ -n "$opt_cover" ]] && synth_args+=( --src-audio "$opt_cover" )
  [[ -n "$opt_ref" ]]   && synth_args+=( --ref-audio "$opt_ref" )
  if [[ "$task_type" == "text2music" ]]; then
    log "  [1/2] ace-lm …"
    ( cd "$work" && "$MUSIC_BIN_LM" --models "$MUSIC_MODELS" --request request.json --device "$device" )
    synth_req="$work/request0.json"
  else
    log "  ace-synth (${task_type}, ohne LM) …"
  fi
  ( cd "$work" && "$MUSIC_BIN_SYNTH" --request "$(basename "$synth_req")" "${synth_args[@]}" )

  # find result (the produced .wav, not the input).
  local produced
  produced="$(find "$work" -maxdepth 1 -name '*.wav' -printf '%T@ %p\n' 2>/dev/null \
             | sort -n | tail -1 | cut -d' ' -f2-)"
  [[ -n "$produced" && -f "$produced" ]] || die "no WAV output found in $work"

  local target
  target="$(unique_path "$outdir" "${ts}_${slug}" "wav")"
  cp -f "$produced" "$target"

  # source: 48 kHz stereo. transcode only on real format/rate change.
  local before="$target"
  target="$(finalize_audio "$target" 48000 2)"
  [[ "$target" != "$before" ]] && log "  FFmpeg: $(basename "$target")"

  write_meta "$target" \
    --arg prompt "$prompt" \
    --argjson seed "$seed" \
    --arg generator "acestep.cpp" \
    --arg lm "$lm_model" \
    --arg synth "$synth_model" \
    --argjson steps "$steps" \
    --argjson shift "$shift" \
    --argjson duration "$duration" \
    --argjson bpm "$bpm" \
    --arg keyscale "$keyscale" \
    --arg timesignature "$timesignature" \
    --argjson lm_temperature "$lm_temperature" \
    --arg solver "$solver" \
    --arg outfmt "$outfmt" \
    --arg device "$device" \
    --arg f "$(basename "$target")" \
    --arg task "$task_type" \
    --arg created "$(date -Iseconds)" \
    '{prompt:$prompt, seed:$seed, generator:$generator, task_type:$task, lm_model:$lm, synth_model:$synth,
      inference_steps:$steps, shift:$shift, duration_s:$duration, bpm:$bpm,
      keyscale:$keyscale, timesignature:$timesignature, lm_temperature:$lm_temperature,
      solver:$solver, output_format:$outfmt, device:$device, file:$f, created:$created}'

  log "done: $target"
  log "  metadata: ${target%.*}.meta.json"
}

# ---------------------------------------------------------------------------
# gaf sfx "prompt"
# ---------------------------------------------------------------------------
cmd_sfx() {
  local prompt="${1:-}"
  [[ -z "$prompt" ]] && die "gaf sfx: prompt missing. Example: gaf sfx \"kart engine revving\""

  [[ -x "$SFX_BIN" ]]    || die "dasheng-audiogen not found: $SFX_BIN (make cuda missing?)"
  [[ -d "$SFX_MODELS" ]] || die "models not found: $SFX_MODELS (run make download-models-q4?)"

  # all four model files must exist.
  local f
  for f in t5_encoder.gguf dit.gguf vocoder.gguf spiece.model; do
    [[ -f "$SFX_MODELS/$f" ]] || die "model file missing: $SFX_MODELS/$f"
  done

  if gpu_busy; then
    warn "GPU busy — waiting until free (no parallel generation)…"
    while gpu_busy; do sleep 5; done
    log "GPU free."
  fi

  local steps duration cfg sway device
  steps="$(cfg sfx.steps 25)"
  duration="$(cfg sfx.duration 5)"
  cfg="$(cfg sfx.cfg 5.0)"
  sway="$(cfg sfx.sway -1.0)"
  device="$(cfg sfx.device CUDA0)"

  local seed
  seed="$(date +%s%N | cut -c1-10)"

  local ts slug outdir
  ts="$(date +%Y%m%d-%H%M%S)"
  slug="$(slugify "$prompt")"
  outdir="$OUTPUT_ROOT/sfx"
  mkdir -p "$outdir"

  local target
  target="$(unique_path "$outdir" "${ts}_${slug}" "wav")"

  log "generating SFX: \"$prompt\""
  log "  steps=$steps  duration=${duration}s  cfg=$cfg  seed=$seed"

  "$SFX_BIN" \
    "$SFX_MODELS/t5_encoder.gguf" \
    "$SFX_MODELS/dit.gguf" \
    "$SFX_MODELS/vocoder.gguf" \
    "$SFX_MODELS/spiece.model" \
    --caption "$prompt" \
    --steps "$steps" \
    --duration "$duration" \
    --cfg "$cfg" \
    --sway "$sway" \
    --seed "$seed" \
    --output "$target"

  # source: 16 kHz mono. transcode only on real format/rate change.
  local before="$target"
  target="$(finalize_audio "$target" 16000 1)"
  [[ "$target" != "$before" ]] && log "  FFmpeg: $(basename "$target") (Dasheng-Original: 16 kHz Mono)"

  write_meta "$target" \
    --arg prompt "$prompt" \
    --argjson seed "$seed" \
    --arg generator "audiogen.cpp (Dasheng AudioGen)" \
    --argjson steps "$steps" \
    --argjson duration "$duration" \
    --argjson cfg "$cfg" \
    --argjson sway "$sway" \
    --arg device "$device" \
    --arg created "$(date -Iseconds)" \
    --arg f "$(basename "$target")" \
    '{prompt:$prompt, seed:$seed, generator:$generator, steps:$steps, duration_s:$duration,
      cfg:$cfg, sway:$sway, device:$device, created:$created, file:$f,
      note:"Dasheng-Original ist 16 kHz Mono; ggf. per FFmpeg resampled."}'

  log "SFX done: $target"
  log "  metadata: ${target%.*}.meta.json"
}

# ---------------------------------------------------------------------------
# gaf ui
# ---------------------------------------------------------------------------
cmd_ui() {
  [[ -x "$MUSIC_BIN_SERVER" ]] || die "ace-server not found: $MUSIC_BIN_SERVER (build missing?)"
  [[ -d "$MUSIC_MODELS" ]]     || die "models not found: $MUSIC_MODELS"

  local host port
  host="$(cfg ui.host 127.0.0.1)"
  port="$(cfg ui.port 8085)"

  log "starting acestep.cpp web interface: http://$host:$port"
  log "  (Strg+C zum Beenden)"
  exec "$MUSIC_BIN_SERVER" \
    --host "$host" \
    --port "$port" \
    --models "$MUSIC_MODELS" \
    --adapters "$MUSIC_REPO/adapters" \
    --max-batch 1
}

# ---------------------------------------------------------------------------
# gaf status
# ---------------------------------------------------------------------------
cmd_status() {
  echo "=== GPU ==="
  nvidia-smi --query-gpu=name,memory.total,memory.used,driver_version \
             --format=csv,noheader 2>/dev/null || echo "  nvidia-smi unavailable"
  echo
  echo "=== Binaries ==="
  _bin "ace-lm"    "$MUSIC_BIN_LM"
  _bin "ace-synth" "$MUSIC_BIN_SYNTH"
  _bin "ace-server" "$MUSIC_BIN_SERVER"
  _bin "dasheng-audiogen" "$SFX_BIN"
  echo
  echo "=== Models ==="
  _dir "ACE-Step (music)" "$MUSIC_MODELS"
  _dir "Dasheng (sfx)"    "$SFX_MODELS"
  echo
  echo "=== FFmpeg ==="
  if command -v ffmpeg >/dev/null 2>&1; then
    echo "  ffmpeg: $(ffmpeg -version 2>/dev/null | head -1 | awk '{print $3}')"
  else
    echo "  ffmpeg: not installed (optional, for OGG/FLAC/resample)"
  fi
  echo
  echo "=== Konfiguration ==="
  echo "  tools_root:  $TOOLS_ROOT"
  echo "  output_root: $OUTPUT_ROOT"
}

_bin() {
  if [[ -x "$2" ]]; then
    printf '  %-18s OK   %s\n' "$1" "$2"
  else
    printf '  %-18s MISSING  %s\n' "$1" "$2"
  fi
}

_dir() {
  if [[ -d "$2" ]] && [[ -n "$(ls -A "$2" 2>/dev/null)" ]]; then
    local n
    n="$(ls -A "$2" | wc -l | tr -d ' ')"
    printf '  %-18s OK   %s (%s files)\n' "$1" "$2" "$n"
  else
    printf '  %-18s MISSING  %s\n' "$1" "$2"
  fi
}

# ---------------------------------------------------------------------------
# gaf help
# ---------------------------------------------------------------------------
cmd_help() {
  cat <<'EOF'
gaf — Game Audio Forge CLI

Usage:
  gaf music "prompt" [options]    instrumental music (ACE-Step 1.5, SFT DiT, CUDA)
  gaf sfx "prompt"                sound effect (Dasheng AudioGen, CUDA)
  gaf ui                          start the acestep.cpp web interface (http://127.0.0.1:8085)
  gaf status                      show GPU, binaries, models, FFmpeg
  gaf help                        this help

music options (CLI > config/gaf.json):
  --bpm N            force tempo (0 = LLM chooses)
  --duration N       seconds 10–600 (0 = LLM chooses)
  --seed N           DiT seed (same seed → similar, not bit-exact songs;
                     the LM run is always random)
  --steps N          denoise steps (more = slower)
  --cover SRC        cover mode: remix SRC (WAV/MP3) into a new style, no LM
  --cover-strength F 1.0=source max, 0=free (cover only)
  --noise-strength F 0..1 start proximity to source (cover only)
  --repaint SRC      regenerate region (with --from/--to), no LM
  --from S --to S    second boundaries for repaint
  --ref AUDIO        timbre reference (any mode)

further parameters via config/gaf.json:
  music.keyscale/timesignature/vocal_language, music.lm_temperature/lm_cfg_scale/
  lm_top_p/lm_top_k, music.use_cot_caption (false = caption verbatim to DiT),
  music.solver (euler|sde|dpm3m|stork4), music.peak_clip (Loudness dB),
  music.vae_chunk (VAE tile size, VRAM lever for long tracks),
  sfx.steps/sfx.duration/sfx.cfg/sfx.sway,
  ffmpeg.enabled/ffmpeg.target_format/ffmpeg.target_rate

Examples:
  gaf music "aggressive metal racing track, fast tempo" --bpm 160 --duration 64
  gaf music "jazz piano cover" --cover output/music/song.wav --cover-strength 0.8
  gaf music "fix intro" --repaint song.wav --from 0 --to 8
  gaf sfx "kart engine revving, high pitch"

Notes:
  - output: WAV, readable names, .meta.json sidecar with prompt+seed.
  - existing files are never overwritten (collision → -2, -3, …).
  - no parallel GPU generation: gaf waits until the GPU is free.
  - Dasheng outputs 16 kHz mono; FFmpeg optionally resamples to 48 kHz.
  - lego/extract/complete (stem modes) need the base model — unavailable with turbo/sft.
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    music)  cmd_music "$@" ;;
    sfx)    cmd_sfx "$@" ;;
    ui)     cmd_ui "$@" ;;
    status) cmd_status "$@" ;;
    help|-h|--help) cmd_help "$@" ;;
    *) die "unknown command: $cmd (see: gaf help)" ;;
  esac
}

main "$@"
