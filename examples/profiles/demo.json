{
  "name": "demo",
  "description": "Example profile — a small demo game audio project.",
  "library": {
    "path": "libraries/demo",
    "kinds": ["sfx", "music", "loop"]
  },
  "defaults": {
    "sample_rate": 48000,
    "bit_depth": 16,
    "loudness_target_lufs": -16.0
  },
  "export": {
    "format": "wav",
    "target": "defold",
    "defold": {
      "sample_rate": 48000,
      "bit_depth": 16,
      "strip_prefix": true
    }
  }
}
